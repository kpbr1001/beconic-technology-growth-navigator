# ⚠️ 실제 키를 이 파일에 넣지 마세요. Netlify > Site settings > Environment variables (Scope: Functions)에만 등록합니다.
# AI 해석(선택) — 비우면 기능 꺼짐. 꺼져 있어도 규칙 기반 진단·보고서는 모두 동작합니다.
BECONIC_AI_ENABLED=
ANTHROPIC_API_KEY=
# 이용 코드(8자 이상) — 운영자가 상담 고객에게만 안내
BECONIC_ACCESS_CODE=
# 비우면 claude-opus-5-5
ANTHROPIC_MODEL=
# low | medium(기본) | high
BECONIC_AI_EFFORT=
# 전체 일일 호출 상한(기본 200) · IP당 일일 상한(기본 10)
BECONIC_AI_DAILY_LIMIT=
BECONIC_AI_IP_LIMIT=
