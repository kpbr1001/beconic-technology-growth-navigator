{
  "name": "beconic-technology-growth-navigator",
  "version": "0.9.12",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-bundle-secrets.mjs",
    "preview": "vite preview --port 8787",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:roadmap": "python3 -m unittest discover -s tests/roadmap",
    "test:e2e": "node tests/e2e/smoke.mjs && node tests/e2e/flow-parity.mjs",
    "test:pdf": "node tests/e2e/pdf-generate.mjs && python3 tests/e2e/pdf_qa.py",
    "lint": "eslint .",
    "ci": "node scripts/check-repo-hygiene.mjs && npm run lint && npm test && npm run test:roadmap && npm run build && npm run test:e2e && npm run test:pdf"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "playwright": "1.56.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@netlify/blobs": "^11.1.3",
    "zod": "^4.6.5"
  }
}
