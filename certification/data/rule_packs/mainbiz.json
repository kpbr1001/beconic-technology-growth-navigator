            {
              "type": "LEAF",
              "id": "MAIN-X-IMPAIRED",
              "label": "직전 사업연도 말 완전자본잠식이 아님",
              "check": "no",
              "args": {
                "q": "main_capital_impaired"
              },
              "source_refs": [
                "S-MAIN-GUIDE"
              ],
              "action_fail": "자본잠식 해소(증자 등) 이후 결산 기준으로 신청할 수 있어요."
