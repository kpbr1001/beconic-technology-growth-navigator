{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "beconic/source.schema.json",
  "title": "공식 출처",
  "type": "object",
  "required": ["source_id", "regulator", "title", "official_url", "source_kind", "checked_at", "access_status", "excerpt_or_section_ref", "review_status"],
  "properties": {
    "source_id": { "type": "string", "pattern": "^S-[A-Z0-9-]+$" },
    "regulator": { "type": "string", "minLength": 2 },
    "title": { "type": "string", "minLength": 2 },
    "official_url": { "type": "string", "pattern": "^(https://|http://www\\.gr\\.or\\.kr/)" },
    "source_kind": { "type": "string" },
    "document_identifier": { "type": ["string", "null"] },
    "published_at": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "effective_from": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "effective_until": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "checked_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "access_status": { "enum": ["OK", "OK_IMAGE", "BLOCKED", "UNREACHABLE", "NOT_FOUND", "USER_OK"] },
    "excerpt_or_section_ref": { "type": "string", "minLength": 5 },
    "reviewer": { "type": ["string", "null"] },
    "review_status": { "enum": ["SOURCE_CHECKED", "UNVERIFIED", "CONFLICTED", "EXPIRED"] }
  }
}
