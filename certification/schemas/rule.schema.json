{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "beconic/rule.schema.json",
  "title": "규칙팩",
  "type": "object",
  "required": ["rule_pack_id", "scheme_id", "rule_version", "review_status", "verification_basis", "valid_from", "review_due_at", "last_verified_at", "combine", "pathways", "test_case_ids"],
  "properties": {
    "review_status": { "enum": ["VERIFIED", "DRAFT", "UNVERIFIED", "CONFLICTED", "EXPIRED"] },
    "valid_from": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "valid_to": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "review_due_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "combine": { "enum": ["AND", "OR"] },
    "pathways": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["pathway_id", "name", "evaluator", "source_refs", "root"] } },
    "test_case_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["type", "id", "label"],
      "properties": {
        "type": { "enum": ["LEAF", "AND", "OR", "WHEN"] },
        "check": { "enum": ["yes", "no", "enum", "gte", "lt", "years_since_gte", "biz_age_gte", "venture_invest_ratio", "venture_rd_ratio", "rnd_institute_staff", "rnd_space", "assessment", "unverified"] },
        "kind": { "enum": ["requirement", "assessment"] },
        "source_refs": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
